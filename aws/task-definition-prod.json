{
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "family": "LearnJenkinsApp-TaskDefinition-Prod",
    "containerDefinitions": [
        {
            "name": "learnjenkinsapp",
            "image": "760674690978.dkr.ecr.eu-west-2.amazonaws.com/myjenkinsapp:#APP_VERSION#",
            "portMappings": [{
                "name": "nginx-80-tcp",
                "containerPort": 80,
                "hostPort": 80,
                "protocol": "tcp",
                "appProtocol": "http"
            }],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                  "awslogs-group": "/ecs/learnjenkinsapp",
                  "awslogs-region": "eu-west-2",
                  "awslogs-stream-prefix": "ecs"
                }
              },
            "essential": true
        }
    ],
    "volumes": [],
    "networkMode": "awsvpc",
    "memory": "512",
    "cpu": "256",
    "executionRoleArn": "arn:aws:iam::760674690978:role/ecsTaskExecutionRole"
}